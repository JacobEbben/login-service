# Login Service settings. Copy to .env for local runs; in production set them as the
# container's environment (secrets from your secret store).
APP_ENV=production
# The public address; it is also the OIDC issuer the apps are configured with.
ISSUER=
# Flask sessions AND the encryption of 2FA secrets. REQUIRED in production (>= 32 characters, from your secret store):
#   docker run --rm login-service python -m login_service.admin secret-key
# Never change it afterwards: every 2FA secret would become unreadable (users then need a reset).
# (Outside production an empty value means: generated once into DATA_DIR/secret.key.)
SECRET_KEY=
DATA_DIR=/app/data
# false only for local http (needs APP_ENV=development)
COOKIE_SECURE=true
SESSION_HOURS=12
REQUIRE_ADMIN_2FA=true
# Admin password (to create the first accounts at /admin/login, and the emergency way in): only its HASH, from
#   docker compose run --rm login-service python -m login_service.admin password
# Keep it single-quoted (it contains $). It is a single factor: remove it once admin accounts exist.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_MINUTES=30
ADMIN_SESSION_MAX_HOURS=4
INVITE_HOURS=48
PRIVACY_CONTACT=
# Behind a reverse proxy that alone can reach the app (it replaces X-Forwarded-For): * and 1
TRUSTED_PROXY=
TRUSTED_PROXY_COUNT=1
